<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#000000">
<title>Зверинья</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;margin:0;padding:0;-webkit-font-smoothing:antialiased}
html,body{height:100%;overflow:hidden;overscroll-behavior:none;background:var(--bg);transition:background .4s ease}
:root{
--bg:#000;
--fg:#fff;
--ui-bg:rgba(28,28,30,.72);
--ui-border:rgba(255,255,255,.08);
--ui-active:rgba(255,255,255,.12);
--tab-inactive:rgba(255,255,255,.35);
}
:root.light{
--bg:#f2f2f7;
--fg:#000;
--ui-bg:rgba(255,255,255,.78);
--ui-border:rgba(0,0,0,.06);
--ui-active:rgba(0,0,0,.08);
--tab-inactive:rgba(0,0,0,.35);
}
canvas{display:block;position:fixed;inset:0;width:100%;height:100%;touch-action:none;cursor:pointer}
canvas.locked{cursor:default}
#top-bar{
position:fixed;top:max(16px,env(safe-area-inset-top));left:50%;transform:translateX(-50%);
display:flex;gap:4px;padding:4px;border-radius:100px;
background:var(--ui-bg);
border:.5px solid var(--ui-border);
backdrop-filter:blur(30px) saturate(180%);
-webkit-backdrop-filter:blur(30px) saturate(180%);
z-index:10;
box-shadow:0 2px 20px rgba(0,0,0,.25);
}
.tab{
border:none;background:transparent;color:var(--fg);
font-size:22px;width:48px;height:40px;border-radius:100px;
display:flex;align-items:center;justify-content:center;
cursor:pointer;padding:0;line-height:1;
opacity:.35;
transition:opacity .2s ease,background .2s ease,transform .15s ease;
font-family:inherit;
}
.tab:active{transform:scale(.92)}
.tab.active{opacity:1;background:var(--ui-active)}
#theme-btn{
position:fixed;top:max(16px,env(safe-area-inset-top));right:max(16px,env(safe-area-inset-right));
width:44px;height:44px;border-radius:100px;
background:var(--ui-bg);border:.5px solid var(--ui-border);
backdrop-filter:blur(30px) saturate(180%);
-webkit-backdrop-filter:blur(30px) saturate(180%);
color:var(--fg);font-size:18px;
display:flex;align-items:center;justify-content:center;
cursor:pointer;z-index:10;
box-shadow:0 2px 20px rgba(0,0,0,.25);
padding:0;font-family:inherit;line-height:1;
transition:transform .18s ease;
}
#theme-btn:active{transform:scale(.9)}
#down-btn{
position:fixed;bottom:max(28px,env(safe-area-inset-bottom));left:50%;
transform:translateX(-50%) translateY(100px) scale(.85);
width:56px;height:56px;border-radius:100px;
background:var(--ui-bg);border:.5px solid var(--ui-border);
backdrop-filter:blur(30px) saturate(180%);
-webkit-backdrop-filter:blur(30px) saturate(180%);
color:var(--fg);
display:flex;align-items:center;justify-content:center;
cursor:pointer;z-index:10;opacity:0;pointer-events:none;
transition:opacity .35s cubic-bezier(.32,.72,0,1),transform .35s cubic-bezier(.32,.72,0,1);
box-shadow:0 8px 40px rgba(0,0,0,.35);
padding:0;font-family:inherit;line-height:1;
}
#down-btn.visible{opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0) scale(1)}
#down-btn:active{transform:translateX(-50%) translateY(0) scale(.92)}
</style>
</head>
<body>
<canvas id="field"></canvas>
<div id="top-bar">
<button class="tab active" data-cat="home">🏠</button>
<button class="tab" data-cat="wild">🌲</button>
<button class="tab" data-cat="sea">🌊</button>
</div>
<button id="theme-btn">🌙</button>
<button id="down-btn">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
<path d="M12 5v14M5 12l7 7 7-7"/>
</svg>
</button>
<script>
const CATS={
home:['🐱','🐶','🐷','🐮','🐰','🐔','🐴','🦃','🐤','🦆','🐂','🦜','🐝','🐟','🐓'],
wild:['🐻','🦊','🐺','🐗','🦌','🦔','🐸','🐍','🦉','🦅','🐼','🐯','🦁','🐵','🦇','🐀'],
sea:['🐙','🦑','🦐','🦞','🦀','🐡','🐠','🐬','🐳','🐋','🦈','🐊','🦭','🐚','🪼','🐢']
};
const GRID=10;
const DPR=Math.min(window.devicePixelRatio||1,2);
const PENT=[261.63,293.66,329.63,392.00,440.00,523.25,587.33,659.25,783.99,880.00];

let canvas,ctx,bgCanvas;
let W=0,H=0,CELL=0,OX=0,OY=0;
let grid=[];
let currentCat='home',currentTheme='dark';
let audioCtx=null,isLocked=false,isAnimating=false;
const popAnims=new Map();
let animPhase=null;
let lastCell=-1;
let needsRender=true;

// ============ ОПТИМИЗАЦИЯ ============
// 1. Один requestAnimationFrame на всё, никаких вложенных
// 2. Рендер только при изменениях (needsRender)
// 3. Кэш эмодзи-спрайтов: рендерим каждый эмодзи один раз в offscreen canvas, потом drawImage
// 4. Кэш фона
// 5. Кэш "стоит на месте" состояния — если ничего не анимируется, не трогаем canvas

const EMOJI_CACHE=new Map();      // animal -> offscreen canvas
const EMOJI_SIZE=128;             // рисуем эмодзи в большом разрешении один раз

function getEmojiSprite(animal){
let c=EMOJI_CACHE.get(animal);
if(c)return c;
c=document.createElement('canvas');
c.width=EMOJI_SIZE;
c.height=EMOJI_SIZE;
const cx=c.getContext('2d');
cx.font=`${Math.floor(EMOJI_SIZE*.82)}px "Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif`;
cx.textAlign='center';
cx.textBaseline='middle';
cx.fillText(animal,EMOJI_SIZE/2,EMOJI_SIZE/2+2);
EMOJI_CACHE.set(animal,c);
return c;
}

function init(){
canvas=document.getElementById('field');
ctx=canvas.getContext('2d',{alpha:false});
resize();
rebuildBg();
canvas.addEventListener('mousemove',onMove);
canvas.addEventListener('touchstart',onTouch,{passive:false});
canvas.addEventListener('touchmove',onTouch,{passive:false});
canvas.addEventListener('touchend',()=>{lastCell=-1});
document.getElementById('down-btn').addEventListener('click',applyDown);
document.getElementById('theme-btn').addEventListener('click',toggleTheme);
document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>switchCat(t.dataset.cat)));
window.addEventListener('resize',()=>{resize();rebuildBg();requestStaticRender()});
document.addEventListener('visibilitychange',()=>{if(document.hidden)lastCell=-1});
rafLoop();
}

function resize(){
W=window.innerWidth;H=window.innerHeight;
canvas.width=Math.floor(W*DPR);canvas.height=Math.floor(H*DPR);
canvas.style.width=W+'px';canvas.style.height=H+'px';
ctx.setTransform(DPR,0,0,DPR,0,0);
const padTop=Math.max(84,window.innerHeight*0.13);
const padBottom=Math.max(96,window.innerHeight*0.15);
const availH=H-padTop-padBottom;
const availW=W-32;
CELL=Math.min(availW/GRID,availH/GRID);
OX=(W-CELL*GRID)/2;
OY=padTop+(availH-CELL*GRID)/2;
grid=Array(GRID).fill(null).map(()=>Array(GRID).fill(null));
}

function rebuildBg(){
bgCanvas=document.createElement('canvas');
bgCanvas.width=Math.floor(W*DPR);bgCanvas.height=Math.floor(H*DPR);
const b=bgCanvas.getContext('2d',{alpha:false});
b.setTransform(DPR,0,0,DPR,0,0);
// Apple-стиль: чистый ровный фон без цветных пятен
b.fillStyle=currentTheme==='dark'?'#000':'#f2f2f7';
b.fillRect(0,0,W,H);
}

function toggleTheme(){
currentTheme=currentTheme==='dark'?'light':'dark';
document.documentElement.classList.toggle('light',currentTheme==='light');
document.getElementById('theme-btn').textContent=currentTheme==='dark'?'🌙':'☀️';
const meta=document.querySelector('meta[name="theme-color"]');
if(meta)meta.setAttribute('content',currentTheme==='dark'?'#000000':'#f2f2f7');
rebuildBg();
requestStaticRender();
}

function onTouch(e){e.preventDefault();const t=e.touches[0];if(!t)return;handlePoint(t.clientX,t.clientY)}
function onMove(e){handlePoint(e.clientX,e.clientY)}

function handlePoint(cx,cy){
if(isLocked||isAnimating)return;
const col=Math.floor((cx-OX)/CELL);
const row=Math.floor((cy-OY)/CELL);
if(col<0||col>=GRID||row<0||row>=GRID)return;
const idx=row*GRID+col;
if(idx===lastCell)return;
lastCell=idx;
if(grid[row][col])return;
if(!audioCtx)initAudio();
const all=CATS[currentCat];
const animal=all[(Math.random()*all.length)|0];
grid[row][col]=animal;
popAnims.set(idx,{start:performance.now(),duration:520});
playNote(animal);
checkFull();
if(!isAnimating)requestStaticRender();
}

function switchCat(cat){
if(isAnimating)return;
if(cat===currentCat)return;
currentCat=cat;
document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.dataset.cat===cat));
for(let r=0;r<GRID;r++)for(let c=0;c<GRID;c++)grid[r][c]=null;
popAnims.clear();isLocked=false;lastCell=-1;updateUI();requestStaticRender();
}

function checkFull(){
for(let r=0;r<GRID;r++)for(let c=0;c<GRID;c++)if(!grid[r][c])return;
isLocked=true;updateUI();
}

function updateUI(){
const btn=document.getElementById('down-btn');
if(isLocked){btn.classList.add('visible');canvas.classList.add('locked')}
else{btn.classList.remove('visible');canvas.classList.remove('locked')}
}

function applyDown(){
if(!isLocked||isAnimating)return;
const toRemove=new Set();
for(let c=0;c<GRID;c++){
let s=0;
while(s<GRID){
const v=grid[s][c];
if(!v){s++;continue}
let e=s+1;
while(e<GRID&&grid[e][c]===v)e++;
if(e-s>=2)for(let r=s;r<e;r++)toRemove.add(r*GRID+c);
s=e;
}
}
for(let r=0;r<GRID;r++){
let s=0;
while(s<GRID){
const v=grid[r][s];
if(!v){s++;continue}
let e=s+1;
while(e<GRID&&grid[r][e]===v)e++;
if(e-s>=2)for(let c=s;c<e;c++)toRemove.add(r*GRID+c);
s=e;
}
}
if(toRemove.size===0){isLocked=false;updateUI();requestStaticRender();return}
isAnimating=true;
const now=performance.now();
const removed=[];
toRemove.forEach(idx=>{
const r=Math.floor(idx/GRID);const c=idx%GRID;
removed.push({row:r,col:c,animal:grid[r][c],idx});
grid[r][c]=null;popAnims.delete(idx);
});
const finalGrid=Array(GRID).fill(null).map(()=>Array(GRID).fill(null));
for(let c=0;c<GRID;c++){
const existing=[];
for(let r=0;r<GRID;r++)if(grid[r][c])existing.push(grid[r][c]);
for(let i=0;i<existing.length;i++)finalGrid[GRID-existing.length+i][c]=existing[i];
}
const fallers=[];
for(let c=0;c<GRID;c++){
const existing=[];
for(let r=0;r<GRID;r++)if(grid[r][c])existing.push({row:r,animal:grid[r][c]});
const n=existing.length;
for(let i=0;i<n;i++){
const fromRow=existing[i].row;const toRow=GRID-n+i;
if(fromRow!==toRow)fallers.push({fromRow,toRow,col:c,animal:existing[i].animal,startY:fromRow*CELL,endY:toRow*CELL});
}
}
for(let r=0;r<GRID;r++)for(let c=0;c<GRID;c++)grid[r][c]=finalGrid[r][c];
playRemoveSound();
animPhase={start:now,removed,fallers,elasticD:380,fallD:400,fallDelay:200};
}

// ============ ELASTIC EASING ============
function elasticOut(t){
if(t<=0)return 0;
if(t>=1)return 1;
const c=1.70158;
const t1=t-1;
return 1+(c+1)*t1*t1*t1+c*t1*t1;
}

// ============ ЕДИНЫЙ RAF-ЦИКЛ ============
function rafLoop(){
if(isAnimating&&animPhase){
const elapsed=performance.now()-animPhase.start;
const fallT=Math.max(0,Math.min((elapsed-animPhase.fallDelay)/animPhase.fallD,1));
const fallEased=1-Math.pow(1-fallT,3);
drawAnimFrame(fallEased,elapsed);
if(elapsed>animPhase.fallD+animPhase.fallDelay+60){
isAnimating=false;animPhase=null;popAnims.clear();
checkFull();
const hasEmpty=grid.some(row=>row.some(cell=>!cell));
if(hasEmpty)isLocked=false;
updateUI();
requestStaticRender();
}
}else{
// статичный рендер — только если popAnims не пуст (т.е. есть анимация появления)
if(popAnims.size>0){
const now=performance.now();
let anyActive=false;
popAnims.forEach(a=>{if(now-a.start<a.duration)anyActive=true;});
if(anyActive){renderStatic();}
else{popAnims.clear();renderStatic();}
}else if(needsRender){
renderStatic();
needsRender=false;
}
}
requestAnimationFrame(rafLoop);
}

function requestStaticRender(){needsRender=true}

// ============ РЕНДЕР ============
function drawSprite(animal,x,y,scale,alpha,glow){
const sp=getEmojiSprite(animal);
const size=CELL*.86*scale;
const half=size/2;
ctx.globalAlpha=alpha;
if(glow>0){
ctx.shadowColor='rgba(120,180,255,.9)';
ctx.shadowBlur=glow;
}
ctx.drawImage(sp,x-half,y-half,size,size);
ctx.shadowBlur=0;
ctx.globalAlpha=1;
}

function renderStatic(){
ctx.drawImage(bgCanvas,0,0,W,H);
const now=performance.now();
let anyPop=false;
for(let r=0;r<GRID;r++){
for(let c=0;c<GRID;c++){
if(!grid[r][c])continue;
const key=r*GRID+c;
const x=OX+c*CELL+CELL/2;
const y=OY+r*CELL+CELL/2;
const pop=popAnims.get(key);
if(pop){
const t=Math.min((now-pop.start)/pop.duration,1);
if(t<1){
anyPop=true;
const eased=elasticOut(t);
const scale=eased;
const alpha=Math.min(1,t*2.5);
const glow=14*(1-t);
drawSprite(grid[r][c],x,y,scale,alpha,glow);
popAnims.set(key,pop);
continue;
}else{
popAnims.delete(key);
}
}
drawSprite(grid[r][c],x,y,1,1,0);
}
}
if(!anyPop&&popAnims.size>0)popAnims.clear();
}

function drawAnimFrame(fallEased,elapsed){
ctx.drawImage(bgCanvas,0,0,W,H);
const fallingSet=new Set();
for(let i=0;i<animPhase.fallers.length;i++)fallingSet.add(animPhase.fallers[i].toRow*GRID+animPhase.fallers[i].col);

// elastic-исчезновение
if(animPhase.removed.length){
for(let i=0;i<animPhase.removed.length;i++){
const cell=animPhase.removed[i];
const t=Math.min(elapsed/animPhase.elasticD,1);
const eased=elasticOut(t);
// elastic-in: сначала слегка раздувается, потом сжимается в 0
const scale=t<.5?(1+eased*.3):(1-eased)*2;
const alpha=Math.max(0,1-t*1.3);
if(alpha<=0||scale<=0)continue;
const x=OX+cell.col*CELL+CELL/2;
const y=OY+cell.row*CELL+CELL/2;
drawSprite(cell.animal,x,y,Math.max(scale,.01),alpha,0);
}
}

// стоящие
for(let r=0;r<GRID;r++){
for(let c=0;c<GRID;c++){
const idx=r*GRID+c;
if(fallingSet.has(idx))continue;
if(grid[r][c])drawSprite(grid[r][c],OX+c*CELL+CELL/2,OY+r*CELL+CELL/2,1,1,0);
}
}

// падающие
if(animPhase.fallers.length){
for(let i=0;i<animPhase.fallers.length;i++){
const f=animPhase.fallers[i];
const y=f.startY+(f.endY-f.startY)*fallEased;
drawSprite(f.animal,OX+f.col*CELL+CELL/2,OY+y+CELL/2,1,1,0);
}
}
}

// ============ АУДИО ============
function initAudio(){
try{const AC=window.AudioContext||window.webkitAudioContext;if(AC)audioCtx=new AC()}catch(e){}
}

function playNote(animal){
if(!audioCtx)return;
if(audioCtx.state==='suspended')audioCtx.resume();
let hash=0;
for(let i=0;i<animal.length;i++)hash=(hash*31+animal.charCodeAt(i))|0;
const freq=PENT[Math.abs(hash)%PENT.length];
const osc=audioCtx.createOscillator();
const gain=audioCtx.createGain();
osc.type='sine';osc.frequency.value=freq;
const now=audioCtx.currentTime;
gain.gain.setValueAtTime(.05,now);
gain.gain.exponentialRampToValueAtTime(.001,now+.45);
osc.connect(gain).connect(audioCtx.destination);
osc.start(now);osc.stop(now+.45);
}

function playRemoveSound(){
if(!audioCtx)return;
if(audioCtx.state==='suspended')audioCtx.resume();
const now=audioCtx.currentTime;
[0,.07,.14].forEach((offset,i)=>{
const osc=audioCtx.createOscillator();
const gain=audioCtx.createGain();
osc.type='sine';
osc.frequency.setValueAtTime(900-i*200,now+offset);
osc.frequency.exponentialRampToValueAtTime(200,now+offset+.2);
gain.gain.setValueAtTime(.07,now+offset);
gain.gain.exponentialRampToValueAtTime(.001,now+offset+.22);
osc.connect(gain).connect(audioCtx.destination);
osc.start(now+offset);osc.stop(now+offset+.22);
});
}

window.addEventListener('DOMContentLoaded',init);
</script>
</body>
</html>
